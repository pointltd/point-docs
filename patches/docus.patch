 <script setup lang="ts">
+import type { ContentNavigationItem } from '@nuxt/content'
+
+type NavigationItem = ContentNavigationItem & {
+  exact?: boolean
+  children?: NavigationItem[]
+}
+
 const { sidebarNavigation } = useSubNavigation()
 
 const contentNavVariants = useUIConfig('contentNavigation')
+
+const exactSidebarNavigation = computed<NavigationItem[]>(() => {
+  const markExact = (items: ContentNavigationItem[] = []): NavigationItem[] => {
+    return items.map((item) => ({
+      ...item,
+      exact: true,
+      children: item.children?.length ? markExact(item.children) : undefined,
+    }))
+  }
+
+  return markExact(sidebarNavigation.value || [])
+})
 </script>
 
